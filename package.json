{
  "name": "iobroker.sehybrid",
  "version": "0.0.1",
  "description": "ioBroker adapter for monitoring and controlling SolarEdge hybrid inverters. Provides access to PV, battery, and operational data, with features such as export power limitation and Storage Control modes.",
  "author": {
    "name": "René Meyer"
  },
  "contributors": [
    {
      "name": "René Meyer"
    }
  ],
  "homepage": "https://github.com/heresiarch/ioBroker.sehybrid",
  "license": "MIT",
  "keywords": [
    "SolarEdge Hybrid Adapter iobroker"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:heresiarch/ioBroker.sehybrid.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "modbus-serial": "8.0.25"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.0.0",
    "@tsconfig/node22": "^22.0.6",
    "fast-check": "4.9.0",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.20.1",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "admin/assets/",
    "build/",
    "www/",
    "scripts/postinstall.js",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "prebuild:react": "rimraf admin/assets admin/index.html admin/tab.html src-admin/build",
    "build:react": "node tasks",
    "watch:react": "npm run watch --prefix src-admin",
    "prebuild": "rimraf build admin/assets admin/index.html admin/tab.html src-admin/build",
    "build": "npm run build:ts && npm run build:react",
    "watch": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit && tsc --noEmit -p src-admin/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs . && npm run lint --prefix src-admin",
    "lint:src": "eslint -c eslint.config.mjs src",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server run --noBrowserSync",
    "dev-server:kill": "bash scripts/kill-dev-server.sh",
    "dev-server:sync": "dev-server run",
    "dev-server:watch": "dev-server watch --noBrowserSync",
    "dev-server:setup": "dev-server setup",
    "dev-server:update": "dev-server update",
    "dev-server:upload": "dev-server upload"
  },
  "bugs": {
    "url": "https://github.com/heresiarch/ioBroker.sehybrid/issues"
  },
  "readmeFilename": "README.md"
}
